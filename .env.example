# Copie este ficheiro para .env e preencha os valores.
# O .env não é versionado.

# Google Maps — chave de browser própria (Google Cloud Console).
# Restrinja-a por referrer HTTP aos domínios da aplicação.
VITE_GOOGLE_MAPS_BROWSER_KEY=""

# Supabase — valores públicos, presentes no bundle do frontend.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
